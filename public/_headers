# Vite fingerprints the JS filename, so it can be cached indefinitely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The atlas has a stable name, so it must be revalidated when it changes.
/atlas.png
  Cache-Control: public, max-age=3600, must-revalidate

# The entry point is what points at the current build; never cache it.
/index.html
  Cache-Control: no-cache
